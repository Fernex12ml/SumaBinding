<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SumaBinding.ViewModels"
             x:Class="SumaBinding.MainPage"
             x:DataType="vm:SumaViewModel"
             Title="Suma con binding">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Suma de dos números"
                   FontSize="24" FontAttributes="Bold" />

            <Label Text="Primer número" />
            <Entry Placeholder="Ejemplo: 8"
                   Keyboard="Numeric"
                   Text="{Binding Numero1, Mode=TwoWay}" />

            <Label Text="Segundo número" />
            <Entry Placeholder="Ejemplo: 5"
                   Keyboard="Numeric"
                   Text="{Binding Numero2, Mode=TwoWay}" />

            <Button Text="Sumar"
                    Command="{Binding SumarCommand}" />

            <Label Text="{Binding Resultado, Mode=OneWay}"
                   FontSize="22" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
